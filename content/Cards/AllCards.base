views:
  - type: table
    name: Table
    order:
      - file.name
      - file.tags
      - date
    sort:
      - property: date
        direction: DESC
      - property: file.tags
        direction: DESC
    limit: 30
    columnSize:
      file.tags: 433
      note.date: 186
  - type: cards
    name: View
    order:
      - file.name
      - date
      - tags
