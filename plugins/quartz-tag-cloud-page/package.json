{
  "name": "quartz-tag-cloud-page",
  "version": "0.1.0",
  "description": "Tag cloud page type plugin for Quartz using d3-cloud.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "quartz": {
    "name": "quartz-tag-cloud-page",
    "displayName": "Quartz Tag Cloud Page",
    "description": "Generates a tags-cloud page with d3-cloud.",
    "category": "pageType",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 126,
    "defaultEnabled": true,
    "defaultOptions": {
      "title": "Tag Cloud",
      "includeTreeTags": true,
      "minCount": 1,
      "minSize": 10,
      "maxSize": 40,
      "gridSize": 8,
      "ellipticity": 1,
      "rotateRatio": 0.22,
      "fontFamily": "system-ui, sans-serif",
      "spiral": "rectangular"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "preact": "^10.0.0"
  }
}
