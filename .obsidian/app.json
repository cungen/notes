{
  "vimMode": true,
  "promptDelete": false,
  "showLineNumber": false,
  "livePreview": true,
  "defaultViewMode": "preview",
  "readableLineLength": true,
  "alwaysUpdateLinks": true,
  "attachmentFolderPath": "content/Attachments",
  "showInlineTitle": true,
  "newFileLocation": "folder",
  "newFileFolderPath": "content/Cards",
  "userIgnoreFilters": [
    "quartz/",
    "content/Attachments/",
    "public/",
    "templates/",
    "package.json",
    "package-lock.json",
    "Dockerfile",
    "node_modules/"
  ],
  "mobileToolbarCommands": [
    "editor:set-heading",
    "editor:toggle-bold",
    "editor:insert-wikilink",
    "editor:insert-embed",
    "editor:indent-list",
    "editor:unindent-list",
    "editor:attach-file",
    "editor:toggle-italics",
    "editor:toggle-strikethrough",
    "editor:toggle-highlight",
    "editor:toggle-code",
    "editor:toggle-blockquote",
    "editor:insert-link",
    "editor:toggle-checklist-status",
    "editor:undo",
    "editor:redo",
    "editor:configure-toolbar"
  ]
}